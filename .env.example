# JWT & Authentication Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=research_lens

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FILTER_MODEL=llama-3.1-8b-instant

# Crawler Settings
DEFAULT_CRAWL_DEPTH=1
DEFAULT_MAX_PAGES=15
CRAWL_TIMEOUT_SECONDS=10
USER_AGENT=ResearchLensBot/1.0 (+https://github.com/researchlens)

# Vector Store & Embedding Settings (ChromaDB + Modern BGE Embedding)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K_RETRIEVAL=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RELEVANCE_THRESHOLD=6.0
